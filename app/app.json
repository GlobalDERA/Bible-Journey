{
  "expo": {
    "name": "Bible Journey",
    "slug": "bible-journey",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "biblejourney",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FFFDF7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biblejourney.app"
    },
    "android": {
      "package": "com.biblejourney.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "themeColor": "#2B4C7E",
      "backgroundColor": "#FFFDF7",
      "name": "Bible Journey",
      "shortName": "BibleJourney",
      "description": "Read the Bible. Understand the Bible. Remember the Bible."
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-audio"
    ]
  }
}
