{
  "expo": {
    "name": "Bible Journey",
    "slug": "bible-journey",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "biblejourney",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FFFDF7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biblejourney.app"
    },
    "android": {
      "package": "com.biblejourney.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/logo192.png",
      "themeColor": "#2B4C7E",
      "backgroundColor": "#FFFDF7",
      "name": "Bible Journey",
      "shortName": "BibleJourney",
      "description": "Read the Bible. Understand the Bible. Remember the Bible."
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-audio"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6bc00e48-1fed-4c10-aa6c-f0d3714c0f8f"
      }
    },
    "owner": "globaldera"
  }
}
